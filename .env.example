# Variables de entorno para testing_payment

# API de Claude (obtén tu clave en https://console.anthropic.com/)
CLAUDE_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-5

# URL del servidor Swagger/API (asegúrate de que está corriendo)
TAIGA_URL=https://api.taiga.io/api/v1
TAIGA_USER=tu_usuario@email.com
TAIGA_PASS=tu_contraseña

# Configuración de logging (opcional)
LOG_LEVEL=INFO

